# ==============================================================================
# LOGIXPRESS TUNISIE - VARIABLES D'ENVIRONNEMENT D'EXEMPLE
#
# Copiez ce fichier en `.env` à la racine du monorepo :
#     cp .env.example .env
#
# Les valeurs ci-dessous sont des valeurs par défaut SÛRES et NON SECRÈTES,
# alignées sur docker-compose.yml (postgres / redis). Elles conviennent à un
# poste de développement local. Ne réutilisez jamais ces secrets en production.
# ==============================================================================

# --- API (Express) ------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000

# --- Frontend (Next.js) -------------------------------------------------------
# Inlinée par Next.js au moment du build : doit pointer vers l'API, pas le web.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Base de données PostgreSQL -----------------------------------------------
# Utilisée par Prisma au runtime et par la CLI (`npm run prisma:*`).
DATABASE_URL="postgresql://logixpress_user:logixpress_secret_pwd@localhost:5432/logixpress_db?schema=public"
# Utilisées par docker-compose.yml pour initialiser le conteneur PostgreSQL.
POSTGRES_USER=logixpress_user
POSTGRES_PASSWORD=logixpress_secret_pwd
POSTGRES_DB=logixpress_db
POSTGRES_PORT=5432
# Journalise chaque requête SQL Prisma (bruyant, à activer pour un debug ponctuel)
# PRISMA_LOG_QUERIES=false

# --- Redis (optionnel) --------------------------------------------------------
# Redis n'est pas requis par l'API actuelle : REDIS_REQUIRED=false signifie que
# l'API démarre et reste "ok" même si Redis est arrêté.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_REQUIRED=false

# --- Sécurité & jetons JWT (HMAC-SHA256) --------------------------------------
# Valeurs de développement uniquement. En production, générez de vrais secrets :
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="dev_jwt_access_secret_change_me_0000000000000000"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_change_me_0000000000000000"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Durcissement (Prompt 26) -------------------------------------------------
# En production (NODE_ENV=production), l'API refuse de démarrer si un secret JWT
# fait moins de 32 caractères, reprend une valeur de ce fichier, ou si les deux
# secrets sont identiques.
#
# Derrière un reverse proxy (nginx, load balancer), faire confiance à
# X-Forwarded-For pour l'IP client (limitation de débit, audit) :
# TRUST_PROXY=true
# TRUST_PROXY_HOPS=1
# En production, 1 relais est supposé par défaut (hébergeurs PaaS) ;
# TRUST_PROXY=false pour une API exposée directement. Contrôle : GET /api/v1/health/network (admin).
#
# Hébergeur (Koyeb, Render…) : PORT est prioritaire sur API_PORT.
#
# Comptes de démonstration (/auth/demo-users) : jamais actifs en production.
# ENABLE_DEMO_ACCOUNTS=true
# Documentation Swagger (/api/v1/docs) : masquée en production sauf si true.
# ENABLE_API_DOCS=false
# Hors production uniquement : journalise le lien de réinitialisation de mot de
# passe (aucun e-mail n'est encore branché).
# PASSWORD_RESET_LOG_TOKEN=true
# Hors production uniquement : coupe la limitation de débit (suites de tests).
# RATE_LIMIT_DISABLED=true
#
# Web : relais /api/v1 vers l'API (lu au build de Next.js), avec
# NEXT_PUBLIC_API_URL=/api/v1.
# API_PROXY_TARGET=http://localhost:4000
# (développement seulement : le relais ne transporte pas les websockets. Sur
# Vercel, NEXT_PUBLIC_API_URL doit être l'URL https absolue de l'API.)
# Adresse de la socket des notifications si elle diffère de l'API :
# NEXT_PUBLIC_SOCKET_URL=https://runex-api.example.koyeb.app
#
# Base de production : `npm run db:bootstrap` (premier administrateur, sans
# données de démonstration) et `npm run db:app-role` (rôle SQL à droits réduits).
# Le seed de démonstration refuse NODE_ENV=production (mots de passe publics).

# --- Notifications poussées (FCM) ---------------------------------------------
# Firebase Admin : requis uniquement si les notifications poussées mobiles sont
# activées. En développement sans identifiants, le canal push reste en
# `skipped` et n'empêche jamais une opération métier.
# Le plus simple : le fichier JSON du compte de service (console Firebase >
# Paramètres du projet > Comptes de service > Générer une nouvelle clé privée),
# en une ligne base64 :  base64 -i fichier.json | pbcopy   (macOS)
# FIREBASE_SERVICE_ACCOUNT_JSON="eyJ0eXBlIjoi..."
# Ou bien les trois valeurs séparées :
# FIREBASE_PROJECT_ID="runex-xxxxx"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@runex-xxxxx.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...==\n-----END PRIVATE KEY-----\n"
# Désactiver explicitement le push même si les variables sont présentes.
# PUSH_ENABLED=true

# --- Présence livreur (PROMPT 24) --------------------------------------------
# Délai au-delà duquel un livreur est considéré hors ligne si aucun battement
# n'a été reçu. Mobile doit battre toutes les 60 s ; 180 s = marge réseau.
# Valeur en secondes, 30–3600, défaut 180.
# DRIVER_PRESENCE_TIMEOUT_SECONDS=180

# --- Configuration métier Tunisie ---------------------------------------------
DEFAULT_HUB_CODE="DEP-BEN-AROUS-HUB"
TIMEZONE="Africa/Tunis"
CURRENCY="TND"
CURRENCY_DECIMALS=3
